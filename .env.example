# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file to GitHub.

# Windsor.ai — from your Windsor.ai dashboard > Settings > API
WINDSOR_API_KEY=

# TikTok/Google Ads account IDs as they appear inside Windsor.ai (comma-separated)
TIKTOK_ACCOUNT_IDS=7438927058295996417,7477300225556824081
GOOGLE_ADS_ACCOUNT_IDS=514-586-0823

# Meta — from developers.facebook.com, a long-lived System User token with
# ads_read permission on each ad account below
META_ACCESS_TOKEN=
META_AD_ACCOUNT_IDS=1085415013613251,1203619500645957

# Anthropic — from console.anthropic.com > API Keys
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
